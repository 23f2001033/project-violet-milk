# =====================================================================
#  PROJECT VIOLET MILK - environment template
#  Copy this file to `.env` and fill in the values.
#  `.env` is gitignored. NEVER commit real keys.
#      PowerShell:  Copy-Item .env.example .env
# =====================================================================

# --- Live on-chain data (Etherscan V2, one key covers 50+ chains) ---
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ETHERSCAN_CHAIN_ID=1

# --- LLM: any OpenAI-compatible provider -----------------------------
# The adapter speaks the standard /chat/completions shape, so xAI, Groq,
# DeepSeek, Together and Gemini's compat endpoint all work unchanged.
# Leave LLM_API_KEY blank and both AI features fall back to deterministic
# templates - the demo still runs end to end.
#
#   xAI     -> https://api.x.ai/v1
#   Groq    -> https://api.groq.com/openai/v1
#   Gemini  -> https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=20

# --- Tron / TRC-20 ---------------------------------------------------
# Most Indian USDT fraud moves on Tron, not Ethereum - fees are cents.
# TronGrid works with NO key; a key only raises the rate limit.
TRONGRID_BASE_URL=https://api.trongrid.io
TRONGRID_API_KEY=

# --- Blockchain evidence anchoring (optional) ------------------------
# Publishes the dossier's SHA-256 so its existence at a point in time
# survives independently of this server.
#
# Use a TESTNET key funded from a faucet. This account signs one tiny
# transaction per dossier and should never hold anything of value.
# Leave blank and the system runs normally, reporting NOT ANCHORED.
#
#   Sepolia RPC: any public endpoint, or your own node
#   Deploy contracts/EvidenceAnchor.sol and paste its address below.
#   With no contract address, the digest is anchored as transaction
#   calldata instead - still permanent, just not queryable by mapping.
ANCHOR_RPC_URL=
ANCHOR_PRIVATE_KEY=
ANCHOR_CONTRACT_ADDRESS=
ANCHOR_CHAIN_ID=11155111
ANCHOR_TIMEOUT_SECONDS=30

# --- Authentication --------------------------------------------------
# AUTH_SECRET signs session tokens. Unset, a random one is generated per
# process - safe, but everyone is signed out when the server restarts.
AUTH_SECRET=
AUTH_TOKEN_HOURS=12

# The seeded officer's password. LEFT AT THE DEFAULT, /health and a red
# banner in the UI both say so - an instance on the default must never be
# mistaken for a secured one. Change it before handling anything real.
DEMO_OFFICER_PASSWORD=violet-demo-2026

# --- Application -----------------------------------------------------
DATA_MODE=synthetic
DB_PATH=./violet.db
DEFAULT_IO_NAME=IO_SHARMA

# --- Trace bounds (see SPEC section 07) ------------------------------
MAX_TRACE_DEPTH=3
MAX_EDGES_PER_NODE=20
MIN_AMOUNT_INR=10000
TIME_WINDOW_HOURS=72

# --- Demo constants (see SPEC section 09) ----------------------------
# Locked FX rate. Every INR->USDT conversion in the dataset, the PDF and
# the deck must derive from this exact number.
DEMO_INR_PER_USDT=90.38

# Stage mode. Serves any address already in data/live_cache/ straight from
# disk instead of calling the explorer. Pre-test your addresses, set this to
# true just before a demo, and every one of them returns instantly even on
# bad venue wifi. Leave it false for real investigative work.
# The UI still shows "EtherscanSource (cached)" - a replay is never presented
# as a live pull.
LIVE_CACHE_FIRST=false

# =====================================================================
#  PROJECT VIOLET MILK - environment template
#  Copy this file to `.env` and fill in the values.
#  `.env` is gitignored. NEVER commit real keys.
#      PowerShell:  Copy-Item .env.example .env
# =====================================================================

# --- Live on-chain data (Etherscan V2, one key covers 50+ chains) ---
ETHERSCAN_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ETHERSCAN_CHAIN_ID=1

# --- LLM: any OpenAI-compatible provider -----------------------------
# The adapter speaks the standard /chat/completions shape, so xAI, Groq,
# DeepSeek, Together and Gemini's compat endpoint all work unchanged.
# Leave LLM_API_KEY blank and both AI features fall back to deterministic
# templates - the demo still runs end to end.
#
#   xAI     -> https://api.x.ai/v1
#   Groq    -> https://api.groq.com/openai/v1
#   Gemini  -> https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=20

# --- Application -----------------------------------------------------
DATA_MODE=synthetic
DB_PATH=./violet.db
DEFAULT_IO_NAME=IO_SHARMA

# --- Trace bounds (see SPEC section 07) ------------------------------
MAX_TRACE_DEPTH=3
MAX_EDGES_PER_NODE=20
MIN_AMOUNT_INR=10000
TIME_WINDOW_HOURS=72

# --- Demo constants (see SPEC section 09) ----------------------------
# Locked FX rate. Every INR->USDT conversion in the dataset, the PDF and
# the deck must derive from this exact number.
DEMO_INR_PER_USDT=90.38
